# Virtual environment (root only — crafter_dreamer/env/ and tetris/env/ are code)
/.venv/
/venv/
/env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# IDE / local tooling
.vscode/
.idea/
*.swp
.claude/

# Local-only: Tetris stages 1-2 (separate learning project, not part of Oneiro)
tetris/

# Project artifacts (heavy, regenerated by training)
runs/
checkpoints/
modal_outputs/
lightning_outputs/
logs/
*.pt
*.npz
*.h5
*.log
# ...mais les données d'expériences du paper SONT versionnées
!experiments/raw_logs/*.log

# Videos: keep small demo gifs only
videos/*_hd.gif

# Secrets / local env (NEVER commit)
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Kaggle run outputs — 7.4 GB sur disque, dont l'essentiel est régénérable.
# On versionne uniquement les DONNÉES d'un run (~5 MB au total) :
#   - le log stdout brut
#   - le summary JSON, qui est la source des figures (experiments/plot_runs.py)
# Les checkpoints .npz et la copie du repo clonée par le kernel restent ignorés.
kaggle_outputs/**
!kaggle_outputs/*/
!kaggle_outputs/*/*.log
!kaggle_outputs/*/runs/
!kaggle_outputs/*/runs/*.json
